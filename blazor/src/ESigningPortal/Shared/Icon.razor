@* A Lucide icon as inline SVG (platform-migration.md: Lucide SVG markup in a small Icon component). *@
<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide @Class" aria-hidden="true" focusable="false">
    @((MarkupString)LucideIcons.Paths[Name])
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string? Class { get; set; }
}
