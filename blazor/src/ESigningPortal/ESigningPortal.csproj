<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Program.cs sets en-US for every viewer (the reference formats with Intl en-US), which needs the full ICU data. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.Views.Blazor" Version="3.119.1" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Blazor.Notifications" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Blazor.Popups" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.2.8" />
    <PackageReference Include="Syncfusion.Licensing" Version="34.2.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown on /healthz. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTime</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
